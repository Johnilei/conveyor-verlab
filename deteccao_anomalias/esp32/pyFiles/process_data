def calculate_rms(data):
    acc_x = np.array(data['x_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_y = np.array(data['y_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_z = np.array(data['z_data'], dtype=float) * CONVERSION_FACTOR_ACC

    rms_x = np.sqrt(np.mean(acc_x**2))
    rms_y = np.sqrt(np.mean(acc_y**2))
    rms_z = np.sqrt(np.mean(acc_z**2))

    print(f"RMS X: {rms_x:.2f}, RMS Y: {rms_y:.2f}, RMS Z: {rms_z:.2f}")

def correct_gravity_dynamically(data):
    # Conversão dos dados do acelerômetro
    acc_x = np.array(data['x_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_y = np.array(data['y_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_z = np.array(data['z_data'], dtype=float) * CONVERSION_FACTOR_ACC

    # Calcular a magnitude total da gravidade
    acc_magnitude = np.sqrt(acc_x**2 + acc_y**2 + acc_z**2)

    # Filtro passa-baixa para estimar a gravidade
    gravity_magnitude = filter_signal(acc_magnitude, cutoff=0.1, order=4, dt=DT)

    # Estimar os componentes da gravidade em cada eixo
    gravity_x = (acc_x / acc_magnitude) * gravity_magnitude
    gravity_y = (acc_y / acc_magnitude) * gravity_magnitude
    gravity_z = (acc_z / acc_magnitude) * gravity_magnitude

    # Remover os componentes da gravidade
    acc_x_corrected = acc_x - gravity_x
    acc_y_corrected = acc_y - gravity_y
    acc_z_corrected = acc_z - gravity_z

    return acc_x_corrected, acc_y_corrected, acc_z_corrected

def moving_average(data, window_size):
    return np.convolve(data, np.ones(window_size)/window_size, mode='valid')

def calculate_displacement(data):
    # Conversão dos dados do acelerômetro
    acc_x = np.array(data['x_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_y = np.array(data['y_data'], dtype=float) * CONVERSION_FACTOR_ACC
    acc_z = np.array(data['z_data'], dtype=float) * CONVERSION_FACTOR_ACC

    # Remoção do componente da gravidade no eixo Z
    acc_z_corrected = acc_z - np.mean(acc_z)  # Remove o valor médio (assumindo que a gravidade é constante)

    # Remoção de possíveis desvios DC nos eixos X e Y
    acc_x_corrected = acc_x - np.mean(acc_x)
    acc_y_corrected = acc_y - np.mean(acc_y)

    # Cálculo do deslocamento acumulado
    disp_x = integrate.cumulative_trapezoid(acc_x_corrected, dx=DT, initial=0)
    disp_y = integrate.cumulative_trapezoid(acc_y_corrected, dx=DT, initial=0)
    disp_z = integrate.cumulative_trapezoid(acc_z_corrected, dx=DT, initial=0)

    # Plot dos deslocamentos acumulados
    plt.figure(figsize=(10, 6))
    plt.plot(np.arange(len(disp_x)) * DT, disp_x, label="Deslocamento X", color="blue")
    plt.plot(np.arange(len(disp_y)) * DT, disp_y, label="Deslocamento Y", color="green")
    plt.plot(np.arange(len(disp_z)) * DT, disp_z, label="Deslocamento Z", color="red")
    plt.title("Deslocamento Acumulado - Eixos X, Y e Z")
    plt.xlabel("Tempo (s)")
    plt.ylabel("Deslocamento (m)")
    plt.grid()
    plt.legend()
    plt.show()

def remove_outliers(data, threshold=3):
    """Remove outliers com base no desvio padrão."""
    mean = np.mean(data)
    std = np.std(data)
    return np.array([x if abs(x - mean) < threshold * std else mean for x in data])

def calculate_displacement_dynamic(data):
    # Corrigir dinamicamente o componente da gravidade
    acc_x_corrected, acc_y_corrected, acc_z_corrected = correct_gravity_dynamically(data)

    # Aplicar detrend para remover tendências
    acc_x_corrected = detrend(acc_x_corrected, type='linear')
    acc_y_corrected = detrend(acc_y_corrected, type='linear')
    acc_z_corrected = detrend(acc_z_corrected, type='linear')

    # Remover outliers
    acc_x_corrected = remove_outliers(acc_x_corrected)
    acc_y_corrected = remove_outliers(acc_y_corrected)
    acc_z_corrected = remove_outliers(acc_z_corrected)

    # Suavizar os dados com filtro Savitzky-Golay (ajustado para cada eixo)
    acc_x_corrected = savgol_filter(acc_x_corrected, window_length=51, polyorder=3)
    acc_y_corrected = savgol_filter(acc_y_corrected, window_length=51, polyorder=3)
    acc_z_corrected = savgol_filter(acc_z_corrected, window_length=51, polyorder=3)

    # Cálculo do deslocamento acumulado
    disp_x = integrate.cumulative_trapezoid(acc_x_corrected, dx=DT, initial=0)
    disp_y = integrate.cumulative_trapezoid(acc_y_corrected, dx=DT, initial=0)
    disp_z = integrate.cumulative_trapezoid(acc_z_corrected, dx=DT, initial=0)

    # Aplicar filtro passa-alta para remover drift
    disp_x = detrend(disp_x, type='linear')
    disp_y = detrend(disp_y, type='linear')
    disp_z = detrend(disp_z, type='linear')

    # Suavizar os deslocamentos acumulados com média móvel
    disp_x = moving_average(disp_x, window_size=30)
    disp_y = moving_average(disp_y, window_size=30)
    disp_z = moving_average(disp_z, window_size=30)

    # Plot dos deslocamentos acumulados
    plt.figure(figsize=(10, 6))
    plt.plot(np.arange(len(disp_x)) * DT, disp_x, label="Deslocamento X", color="blue")
    plt.plot(np.arange(len(disp_y)) * DT, disp_y, label="Deslocamento Y", color="green")
    plt.plot(np.arange(len(disp_z)) * DT, disp_z, label="Deslocamento Z", color="red")
    plt.title("Deslocamento Acumulado - Eixos X, Y e Z (Correção Avançada)")
    plt.xlabel("Tempo (s)")
    plt.ylabel("Deslocamento (m)")
    plt.grid()
    plt.legend()
    plt.show()

